rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    /* ============================================================
       🚀 PERMANENT ADMIN BYPASS (RAVI POLICE)
       This block guarantees access for your UID and Email.
    ============================================================ */
    match /{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == "k3dvMjtvoWMz6tpl3iLYpxS3NPw1" || 
        request.auth.token.email.toLower() == "ravipolice@gmail.com"
      );
    }

    /* ============================================================
       🔐 SECURITY HELPERS
    ============================================================ */
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "k3dvMjtvoWMz6tpl3iLYpxS3NPw1" ||
        request.auth.token.email.toLower() == "ravipolice@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.toLower()))
      );
    }

    function isServiceAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == "service_account";
    }

    /* ============================================================
       🔹 EMPLOYEES & OFFICERS
    ============================================================ */
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      // Allow users to update their own non-sensitive fields
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.firebaseUid || 
        request.auth.token.email == resource.data.email
      ) && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'isApproved', 'email', 'kgid']);
    }

    match /officers/{officerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isServiceAccount();
    }

    match /admin_employees/{employeeId} {
      allow read, write: if isAdmin() || isServiceAccount();
    }

    /* ============================================================
       🔹 PENDING REGISTRATIONS
    ============================================================ */
    match /pending_registrations/{docId} {
      allow create: if true; // Allow anyone to register
      allow read: if isAuthenticated() && (
        isAdmin() || 
        request.auth.token.email.toLower() == resource.data.email.toLower()
      );
      allow update, delete: if isAdmin();
    }

    /* ============================================================
       🔹 MASTER DATA (Districts, Stations, Ranks)
    ============================================================ */
    match /districts/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isServiceAccount();
    }

    match /stations/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isServiceAccount();
    }

    match /rankMaster/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isServiceAccount();
    }

    /* ============================================================
       🔹 OTHER COLLECTIONS
    ============================================================ */
    match /admins/{id} {
      allow read, write: if isAdmin();
    }

    match /useful_links/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaveBalances/{kgid} {
      allow read, write: if isAdmin() || (
        isAuthenticated() && 
        get(/databases/$(database)/documents/employees/$(kgid)).data.firebaseUid == request.auth.uid
      );
      
      match /{allSubcollections=**} {
        allow read, write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/employees/$(kgid)).data.firebaseUid == request.auth.uid
        );
      }
    }

    match /uids/{uid} {
      allow read, write: if isAuthenticated() && uid == request.auth.uid;
    }
    
    match /meta/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
